# Copiar a .env. No versionar el archivo con valores reales.
RABBIT_USER=admin
RABBIT_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL
RABBIT_ERLANG_COOKIE=CAMBIAR_POR_VALOR_ALEATORIO_LARGO
DB_NAME=pedidos360
DB_USERNAME=pedidos360
DB_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL
DB_ROOT_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL

# Opcional: cuenta SMTP para notifications-service. Si no se configura,
# el servicio sigue consumiendo la cola, pero no puede enviar correo real.
MAIL_USERNAME=
MAIL_PASSWORD=

# AWS Console > DynamoDB > Tablas: nombre de tabla; Region visible arriba.
# Con rol IAM en EC2, NO rellenar AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY.
AWS_REGION=us-east-1
DYNAMODB_TABLE=Pedidos360Events
DYNAMODB_ENABLED=false

# Solo para el despliegue en dos EC2. Consultar Private IPv4 en EC2 > Instances.
# IP privada de la EC2 que ya aloja frontend, MariaDB y microservicios.
CORE_PRIVATE_IP=IP_PRIVADA_EC2_ACTUAL
# IP privada de la nueva EC2 t3.large con Kafka, Rabbit y servicios nuevos.
PLATFORM_PRIVATE_IP=IP_PRIVADA_EC2_NUEVA

# URL exacta desde la barra del navegador. Es un ORIGEN, sin / al final.
FRONTEND_ORIGIN=http://localhost:4200
FRONTEND_BASE_URL=http://localhost:4200

# Alias de demostracion antifraude: usar sal aleatoria local, nunca subirla.
CARD_HASH_SALT=CAMBIAR_POR_VALOR_ALEATORIO_LARGO

# Credenciales PUBLICAS del ambiente de integracion de Webpay Plus.
# Copiar desde la documentacion oficial de Transbank Developers;
# no usar datos de comercio real en este repositorio.
WEBPAY_COMMERCE_CODE=COMERCIO_DE_INTEGRACION
WEBPAY_API_KEY=CLAVE_DE_INTEGRACION
